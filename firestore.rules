rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      // 1. Public read allowed for all visitors
      allow read: if true;
      
      // 2. Public create allowed with strict validation:
      //    - name: string between 1 and 40 characters
      //    - stars: number equal to 4 or 5
      //    - message: string between 1 and 300 characters
      //    - createdAt: valid server/client timestamp
      //    - keys: only permitted review fields
      allow create: if request.resource.data.keys().hasOnly(['name', 'stars', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 300
                    && request.resource.data.stars is number
                    && (request.resource.data.stars == 4 || request.resource.data.stars == 5)
                    && request.resource.data.createdAt is timestamp;
                    
      // 3. Prevent any client updates or deletes (tamper-proof)
      allow update, delete: if false;
    }
  }
}
